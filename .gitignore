# dependencies
node_modules

# next.js build output and its Turbopack cache
# (must never be committed — the cache is machine- and OS-specific, and a
# checked-in copy makes `next dev` panic on any other machine)
.next
out

# typescript
tsconfig.tsbuildinfo
next-env.d.ts

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server.log

# env files
.env
.env*.local
# Vercel project link (per-machine)
.vercel

# Local AI-tool state (logs, worktrees)
.claude/
# Impeccable run artifacts (QA screenshots, decision pages, live sessions); the
# design record (DESIGN.md, .impeccable/design.json, surfaces/, critique/) stays tracked
.impeccable/review/
.impeccable/questions/
.impeccable/live/sessions/
.impeccable/mocks/
