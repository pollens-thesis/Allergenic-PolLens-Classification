DJANGO_SECRET_KEY=change-me
# Defaults to false (production-safe); local dev turns it on here.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_NAME unset to fall back to sqlite for local dev.
DATABASE_NAME=
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Managed Postgres hosts (e.g. Neon) require SSL.
DATABASE_SSLMODE=require

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex list, e.g. ^https://pollens-[a-z0-9-]+\.vercel\.app$ for Vercel previews
CORS_ALLOWED_ORIGIN_REGEXES=
# Django admin over HTTPS, e.g. https://pollens-api.onrender.com (added automatically on Render)
CSRF_TRUSTED_ORIGINS=

GOOGLE_OAUTH_CLIENT_ID=

ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=
ROBOFLOW_MODEL_VERSION=
# true = serve a canned Roboflow-shaped response until the model is deployed
ROBOFLOW_MOCK=true

OPENWEATHER_API_KEY=

# Slide image storage. Leave AWS_STORAGE_BUCKET_NAME empty for local disk
# (api/media/). Production: Cloudflare R2 — see ../docs/deployment.md.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Lifetime of presigned image URLs, seconds
AWS_QUERYSTRING_EXPIRE=3600
