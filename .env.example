# Both are inlined into the browser bundle at build time — after changing
# them (locally or in Vercel's project settings), rebuild / redeploy.

# Google OAuth 2.0 Web client ID (same one as api/'s GOOGLE_OAUTH_CLIENT_ID).
# The site's origin must be listed under the client's Authorized JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# The Django API's origin, no trailing slash — http://localhost:8000 locally,
# the Render URL (https://<name>.onrender.com) in production.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
