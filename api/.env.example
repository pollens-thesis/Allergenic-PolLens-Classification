DJANGO_SECRET_KEY=change-me
# Defaults to false (production-safe); local dev turns it on here.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# One connection string (as Neon's dashboard shows it) — preferred. Overrides
# the separate DATABASE_* values below when set.
# DATABASE_URL=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Or the separate values. Leave DATABASE_URL and DATABASE_NAME unset to fall
# back to sqlite for local dev.
DATABASE_NAME=
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Managed Postgres hosts (e.g. Neon) require SSL.
DATABASE_SSLMODE=require

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex list, e.g. ^https://pollens-[a-z0-9-]+\.vercel\.app$ for Vercel previews
CORS_ALLOWED_ORIGIN_REGEXES=
# Django admin over HTTPS, e.g. https://pollens-api.onrender.com (added automatically on Render)
CSRF_TRUSTED_ORIGINS=

GOOGLE_OAUTH_CLIENT_ID=
# Microsoft Entra (multitenant) app registration's Application (client) ID
MICROSOFT_CLIENT_ID=

# Who may sign in with either provider. A domain also admits its subdomains
# (mseuf.edu.ph admits student.mseuf.edu.ph). Both empty admits nobody.
SIGNIN_ALLOWED_DOMAINS=up.edu.ph,mseuf.edu.ph
SIGNIN_ALLOWED_EMAILS=

# Optional overrides: request limits and per-image size limit
# THROTTLE_ANON=600/hour
# THROTTLE_USER=5000/hour
# THROTTLE_DETECT=600/hour
# THROTTLE_LOGIN=30/minute
# MAX_SLIDE_IMAGE_MB=25
# Largest slide image in megapixels (width x height); bigger images are refused
# before they are decoded, so a tiny compressed file can't exhaust memory.
# MAX_SLIDE_IMAGE_MEGAPIXELS=60
# HTTPS Strict-Transport-Security max-age in seconds (production only).
# DJANGO_HSTS_SECONDS=86400

# Detection provider: `remote` (the default) calls the hosted inference service
# below (services/inference on Modal; see docs/inference-modal.md). `yolo26`
# loads the same models in this process (docs/yolo26-staging.md).
DETECTION_BACKEND=remote
# Base URL of the inference service (no trailing /detect) and its bearer token
# (the Modal secret pollens-inference; ask the team, never commit it). The URL
# is shown on the Inference.web function in the Modal dashboard, e.g.
# https://<workspace>--pollens-inference-inference-web.us-east.modal.run
# The timeout covers a cold start.
INFERENCE_URL=
INFERENCE_TOKEN=
INFERENCE_TIMEOUT=120
YOLO26_WEIGHTS_PATH=
YOLO26_CLASSIFIER_WEIGHTS_PATH=
YOLO26_CONFIDENCE=0.25
YOLO26_IMAGE_SIZE=640
YOLO26_DEVICE=cpu

# Render model deployment: the start script downloads this ZIP from a private
# S3-compatible model bucket and checks the configured SHA-256 before loading.
YOLO26_ARTIFACTS_ENDPOINT_URL=
YOLO26_ARTIFACTS_BUCKET=
YOLO26_ARTIFACTS_OBJECT_KEY=
YOLO26_ARTIFACTS_BUNDLE_SHA256=
YOLO26_ARTIFACTS_ACCESS_KEY_ID=
YOLO26_ARTIFACTS_SECRET_ACCESS_KEY=

# true = serve a canned response for demo/offline mode; it overrides the backend
# (reports are saved flagged as samples). Set it to false, with INFERENCE_URL
# and INFERENCE_TOKEN filled in, to run real detections locally. Was
# ROBOFLOW_MOCK before 2026-10-14: rename it in an existing .env.
DETECTION_MOCK=true


# Slide image storage. Leave AWS_STORAGE_BUCKET_NAME empty for local disk
# (api/media/). Production: Cloudflare R2 — see ../docs/deployment.md.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Lifetime of presigned image URLs, seconds
AWS_QUERYSTRING_EXPIRE=3600
